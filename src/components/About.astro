---
import theme from '../data/Theme.json';
import { Image } from 'astro:assets';

import wall from '../assets/wall.webp';
import collage from '../assets/collage.webp';
---

<section id="about">
    <Image src={wall} class="aboutImage" alt="" />

    <article class="aboutContent">
        <div class="aboutText">
            <h2 data-i18n="about.title">Hola, soy</h2>
            <h1>JUAN GÓMEZ</h1>

            <p data-i18n="about.aboutme">
                Comunicador social con <i>tres años de experiencia</i> en producción audiovisual para
                proyectos narrativos, comerciales, gaming y verticales.
                <br /><br />
                Un buen mensaje se queda corto sin una planeación adecuada que defina la intención
                de su transmisor y un enfoque claro para el público objetivo; mi trabajo es,
                precisamente, <i>ayudar a comunicarte con tu audiencia</i> de manera única y efectiva.
            </p>

            <div class="aboutActions">
                <a
                    data-i18n="about.download"
                    data-cv-es="/cvs/Curriculum-Juan-Gomez.pdf"
                    data-cv-en="/cvs/Juan-Gomez-resume.pdf"
                    href="/cvs/Curriculum-Juan-Gomez.pdf.pdf"
                    download="Curriculum Juan Gomez.pdf"
                    class="button1"
                >
                    Descargar CV
                </a>

                <div class="aboutSocials">
                    <a class="instagram"
                        href="https://www.instagram.com/jupamongo/"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                    >
                        <svg class="instagram" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"/>
                        </svg>
                    </a>

                    <a
                        href="https://www.youtube.com/@juangopro"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="YouTube"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                            <path d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.01 2.01 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.01 2.01 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31 31 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.01 2.01 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A100 100 0 0 1 7.858 2zM6.4 5.209v4.818l4.157-2.408z"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <Image src={collage} class="collage" alt="" />
    </article>
</section>

<style
    define:vars={{
        white: theme.colors.white,
        black: theme.colors.black,
        red1: theme.colors.red1,
        title: theme.fonts.title.name,
        main: theme.fonts.main.name
    }}
>
    #about {
        position: relative;
        height: 100vh;
        z-index: 1;
        overflow: hidden;
    }

    .aboutImage {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        z-index: 1;
    }

    .aboutContent {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 105vh;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6vh;
        z-index: 2;
    }

    .aboutText h2 {
        margin: 0;
        font-family: var(--main);
        font-size: 3vh;
        font-style: italic;
        font-weight: 500;
        color: var(--red1);
    }

    .aboutText h1 {
        margin: -0.5vh 0 0;
        padding-bottom: 4vh;
        font-family: var(--title);
        font-size: 6vh;
        font-weight: 800;
        color: var(--red1);
    }

    .aboutText p {
        margin: 0;
        padding: 0 2vh 2vh 0;
        font-family: var(--main);
        font-size: 1.6vh;
        font-weight: 500;
        line-height: 2vh;
        color: var(--black);
    }

    .collage {
        width: 57vh;
        height: auto;
    }

    .aboutActions {
        display: flex;
        align-items: center;
        gap: 2vh;
    }

    .aboutActions > a.button1 {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        margin-top: 2vh;
        text-decoration: none;
        line-height: normal;
        flex-shrink: 0;
    }

    .aboutSocials {
        display: flex;
        align-items: center;
        gap: 1.5vh;
        margin-top: 2vh;
    }

    .instagram {
        width: 3.2vh;
        height: 3.2vh;
    }

    .aboutSocials a {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: 0;
        background: none;
        border: none;
        color: var(--red1);
        cursor: pointer;
        text-decoration: none;
    }

    .aboutSocials svg {
        width: 4vh;
        height: 4vh;
    }

    .aboutSocials a:hover {
        color: var(--red2);
    }

    .aboutSocials a:active {
        color: var(--red2);
        border-radius: 50%;
        filter: drop-shadow(0 0 1vh var(--red1));
    }

    /* mobile layout */
    @media (max-width: 768px) {
        #about {
            height: 100vh;
            min-height: 100vh;
            overflow: hidden;
        }

        .aboutContent {
            position: relative;
            top: auto;
            left: auto;
            transform: none;
            width: 100%;
            height: auto;
            min-height: 100vh;
            box-sizing: border-box;
            flex-direction: column;
            justify-content: flex-start;
            gap: 3vh;
            padding: 6vh 6vw;
        }

        .collage {
            order: -1;
            width: 110%;
            max-width: 45vh;
            height: auto;
        }

        .aboutText {
            width: 40vh;
        }

        .aboutText h2 {
            font-size: 2.2vh;
        }

        .aboutText h1 {
            font-size: 4.2vh;
            padding-bottom: 1.4vh;
        }

        .aboutText p {
            padding-right: 0;
            padding-bottom: 0.2vh;
            font-size: 1.7vh;
            line-height: 2vh;
        }

        .aboutActions {
            flex-wrap: wrap;
        }

        .aboutSocials {
            gap: 2vh;
        }

        .aboutSocials svg {
            width: 3.5vh;
            height: 3.5vh;
        }
    }

    /* tablet layout */
    @media (min-width: 769px) and (max-width: 1300px) {
        #about {
            height: auto;
            min-height: 100vh;
        }

        .aboutContent {
            position: relative;
            top: auto;
            left: auto;
            transform: none;
            width: 100%;
            height: auto;
            min-height: 100vh;
            box-sizing: border-box;
            flex-direction: column;
            justify-content: flex-start;
            gap: 2vh;
            padding: 4vh 6vw;
        }

        .collage {
            order: -1;
            width: 65%;
            max-width: 50vh;
            height: auto;
        }

        .aboutText {
            width: 80%;
        }

        .aboutText h2 {
            font-size: 2.5vh;
        }

        .aboutText h1 {
            font-size: 5vh;
            padding-bottom: 2vh;
        }

        .aboutText p {
            padding-right: 0;
            font-size: 1.8vh;
            line-height: 2.4vh;
        }
    }
</style>